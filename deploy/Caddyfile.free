:80 {
	encode gzip

	handle /v1/* {
		reverse_proxy api:8080
	}

	handle /actuator/health* {
		reverse_proxy api:8080
	}

	# Métricas e demais endpoints do actuator só pela rede interna (api:8080).
	handle /actuator/* {
		respond 404
	}

	handle /internal/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
